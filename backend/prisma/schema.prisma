generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  draft
  final
}

enum TemplateFieldType {
  text
}

enum SubscriptionPlan {
  freemium
  basic
  pro
}

enum PaymentType {
  subscription
  single_contract
}

enum PaymentStatus {
  pending
  succeeded
  canceled
  refunded
}

enum SubscriptionStatus {
  active
  canceled
  past_due
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  hashedPassword String?
  yandexId       String?        @unique
  displayName    String?
  avatarUrl      String?
  isActive       Boolean        @default(true)
  isAdmin        Boolean        @default(false)
  emailVerified  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  templates      Template[]
  subscriptions  Subscription[]
  documents      Document[]     @relation("UserDocuments")
  payments       Payment[]
  usageRecord    UsageRecord?
  clarifications ClarificationUsage[]
}

model Template {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  content     String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  documents   Document[]
  groups      TemplateGroup[]
  fields      TemplateField[]
  sections    TemplateSection[]
}

model Subscription {
  id                      String             @id @default(uuid())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  userId                  String
  plan                    SubscriptionPlan
  status                  SubscriptionStatus
  expiresAt               DateTime?
  yookassaPaymentMethodId String? // payment method ID for recurring payments
  autoRenew               Boolean            @default(true)
  user                    User               @relation(fields: [userId], references: [id])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  amount            Int // in kopeks (100 kopeks = 1 ruble)
  currency          String        @default("RUB")
  type              PaymentType
  status            PaymentStatus
  yookassaPaymentId String?       @unique
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
}

model UsageRecord {
  id                 String   @id @default(uuid())
  userId             String   @unique
  contractsThisMonth Int      @default(0)
  clarificationsUsed Int      @default(0)
  extraContractsPaid Int      @default(0) // single contracts purchased this month
  periodStart        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
}

model ClarificationUsage {
  id          String   @id @default(uuid())
  userId      String
  documentId  String
  periodStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, periodStart])
  @@index([userId, periodStart])
}

model GuestAccess {
  id        String   @id @default(uuid())
  ip        String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String            @id @default(uuid())
  title      String
  ownerId    String
  templateId String?
  status     DocumentStatus
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      User              @relation("UserDocuments", fields: [ownerId], references: [id])
  template   Template?         @relation(fields: [templateId], references: [id])
  versions   DocumentVersion[]
  fields     ContractField[]
  sections   ContractSection[]
  clarifications ClarificationUsage[]
}

model DocumentVersion {
  id             String          @id @default(uuid())
  version        Int
  content        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id])
  riskAssessment RiskAssessment?

  @@unique([documentId, version])
}

model RiskAssessment {
  id                String          @id @default(uuid())
  summary           String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  documentVersionId String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model TemplateGroup {
  id         String   @id @default(uuid())
  templateId String
  label      String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   TemplateField[]
}

model TemplateField {
  id           String            @id @default(uuid())
  templateId   String
  groupId      String
  label        String
  key          String
  type         TemplateFieldType @default(text)
  defaultValue String?
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  template       Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group          TemplateGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contractFields ContractField[]

  @@unique([templateId, key])
}

model ContractField {
  id              String   @id @default(uuid())
  documentId      String
  templateFieldId String?
  groupLabel      String
  groupOrder      Int      @default(0)
  label           String
  key             String
  value           String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  templateField TemplateField? @relation(fields: [templateFieldId], references: [id], onDelete: SetNull)

  @@unique([documentId, key])
}

model TemplateSection {
  id         String   @id @default(uuid())
  templateId String
  title      String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template  Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  contracts ContractSection[]
}

model ContractSection {
  id                String   @id @default(uuid())
  documentId        String
  templateSectionId String?
  title             String
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  templateSection TemplateSection? @relation(fields: [templateSectionId], references: [id], onDelete: SetNull)
}

model SystemNotice {
  id        String   @id @default("system_notice")
  message   String   @default("")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationCode {
  id             String   @id @default(uuid())
  email          String
  hashedPassword String
  code           String
  expiresAt      DateTime
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([email])
}
